#!/usr/bin/env bash
set -euo pipefail

# Remember where the user ran us from, so relative paths work
ORIG_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Flags that take a value on the next arg. Their values must NOT be
# path-resolved (they're category names, specs, etc.) — except the PATH
# ones whose values are files.
VALUE_FLAGS_NONPATH=("--only" "--exclude" "--fail-on" "--policy" "--top")
VALUE_FLAGS_PATH=("-o" "--out" "--baseline" "--config")

# Subcommands are pass-through tokens; don't path-resolve them.
SUBCOMMANDS=("init" "policies" "baseline" "check" "dir" "scan" "history")

is_in() {
  local needle="$1"; shift
  for x in "$@"; do [[ "$x" == "$needle" ]] && return 0; done
  return 1
}

# Resolve file arguments to absolute paths before cd-ing into the repo.
# Two classes of value-taking flags: paths (resolve) and non-paths (pass through).
#
# Special case: `--git <ref> [<ref2>] -- <file> [<file2>]`. EVERYTHING
# inside the git block must pass through raw — the refs (HEAD~5,
# origin/main, abc123) obviously don't get path-resolved, but the files
# also need to stay repo-relative because `git show <ref>:<path>` only
# accepts repo-relative paths. After the `--`, positional args are
# files-in-git-mode (pass raw); dash-args still trigger normal flag
# handling so things like `-o /tmp/out.html` still work.
resolved_args=()
skip_next_mode=none   # none | path | raw
git_mode=none         # none | refs (between --git and --) | files (after --)
first_positional=1    # track so we can recognize a leading subcommand
for arg in "$@"; do
  if [[ "$skip_next_mode" == "path" ]]; then
    if [[ "$arg" == /* || "$arg" == -* ]]; then
      resolved_args+=("$arg")
    else
      resolved_args+=("$ORIG_DIR/$arg")
    fi
    skip_next_mode=none
    continue
  fi
  if [[ "$skip_next_mode" == "raw" ]]; then
    resolved_args+=("$arg")
    skip_next_mode=none
    continue
  fi
  # Inside the --git ref block: refs pass raw, switch to files mode on `--`.
  if [[ "$git_mode" == "refs" ]]; then
    resolved_args+=("$arg")
    if [[ "$arg" == "--" ]]; then
      git_mode=files
    fi
    continue
  fi
  # After the `--` in git mode: positional args are file paths but git
  # needs them repo-relative, so pass raw. Dash-args fall through.
  if [[ "$git_mode" == "files" && "$arg" != -* ]]; then
    resolved_args+=("$arg")
    continue
  fi
  if [[ "$arg" == "--git" ]]; then
    resolved_args+=("$arg")
    git_mode=refs
    continue
  fi
  if [[ "$arg" == -* ]]; then
    resolved_args+=("$arg")
    if is_in "$arg" "${VALUE_FLAGS_PATH[@]}"; then
      skip_next_mode=path
    elif is_in "$arg" "${VALUE_FLAGS_NONPATH[@]}"; then
      skip_next_mode=raw
    fi
  elif [[ "$arg" == "-" ]]; then
    resolved_args+=("$arg")
    first_positional=0
  elif [[ "$first_positional" -eq 1 ]] && is_in "$arg" "${SUBCOMMANDS[@]}"; then
    resolved_args+=("$arg")
    first_positional=0
  elif [[ "$arg" == /* ]]; then
    resolved_args+=("$arg")
    first_positional=0
  else
    resolved_args+=("$ORIG_DIR/$arg")
    first_positional=0
  fi
done

cd "$SCRIPT_DIR"

# Build if dist-cli is missing or stale
rebuild=0
if [ ! -f dist-cli/cli/index.js ]; then
  rebuild=1
else
  # find (not glob) so nested analysis/**/*.ts picks up narrative/*, etc.
  newest="$(find src/cli src/analysis -type f -name '*.ts' -newer dist-cli/cli/index.js -print -quit 2>/dev/null || true)"
  if [ -n "$newest" ] || [ src/lib/report.ts -nt dist-cli/cli/index.js ]; then
    rebuild=1
  fi
fi
if [ "$rebuild" -eq 1 ]; then
  bash tools/build-cli.sh >&2
fi

SAMEDIFF_ORIG_DIR="$ORIG_DIR" exec node dist-cli/cli/index.js "${resolved_args[@]}"
