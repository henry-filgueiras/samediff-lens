#!/usr/bin/env bash
set -euo pipefail

# Remember where the user ran us from, so relative paths work
ORIG_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Resolve file arguments to absolute paths before cd-ing into the repo
resolved_args=()
for arg in "$@"; do
  if [[ "$arg" == -* ]]; then
    resolved_args+=("$arg")
  elif [[ "$arg" == /* ]]; then
    resolved_args+=("$arg")
  else
    resolved_args+=("$ORIG_DIR/$arg")
  fi
done

cd "$SCRIPT_DIR"

# Build if dist-cli is missing or stale
if [ ! -f dist-cli/cli/index.js ] || [ src/cli/index.ts -nt dist-cli/cli/index.js ] || [ src/cli/formatCli.ts -nt dist-cli/cli/index.js ] || [ src/analysis/heuristics.ts -nt dist-cli/cli/index.js ]; then
  bash tools/build-cli.sh >&2
fi

SAMEDIFF_ORIG_DIR="$ORIG_DIR" exec node dist-cli/cli/index.js "${resolved_args[@]}"
