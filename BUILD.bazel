load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# Lightweight Bazel entrypoints for a local Vite repo.
# These targets intentionally wrap the existing npm-based workflow instead of
# introducing a heavier JS rules stack for v0.

sh_binary(
    name = "devserver",
    srcs = ["tools/devserver.sh"],
)

sh_binary(
    name = "build",
    srcs = ["tools/build.sh"],
)

sh_binary(
    name = "test",
    srcs = ["tools/test.sh"],
)
